# Extraction and the web-search tier of the advisor. Without it the app still
# runs: extraction falls back to the deterministic parser, and Discover works
# from your own saves and the published-trips corpus only.
ANTHROPIC_API_KEY=

# The advisor's third tier. Cheap per call, and only used when the two free
# tiers leave a section short.
GOOGLE_PLACES_API_KEY=

# The deployed origin. Without it the OpenGraph card and other absolute
# metadata URLs fall back to a placeholder domain, so a shared link previews
# with a broken image. Set this to the Vercel URL or your custom domain.
NEXT_PUBLIC_SITE_URL=

# Where the in-app review prompt sends people. Falls back to a placeholder
# App Store search URL until a real listing exists.
NEXT_PUBLIC_STORE_URL=

# Partner links on the checks screen. With these unset the links are ordinary,
# non-affiliate ones and nothing on screen claims a commission.
NEXT_PUBLIC_AMAZON_ASSOCIATE_TAG=
NEXT_PUBLIC_AMAZON_DOMAIN=www.amazon.com
NEXT_PUBLIC_ESIM_PARTNER=Airalo
NEXT_PUBLIC_ESIM_URL=https://www.airalo.com/search
NEXT_PUBLIC_ESIM_REF=
